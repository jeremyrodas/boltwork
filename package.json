{
  "name": "strongroom",
  "version": "0.1.0",
  "private": true,
  "description": "Strongroom: a local-first, end-to-end encrypted password manager",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node scripts/build.mjs --tests && node --test dist-test/*.test.js",
    "dist": "node scripts/build.mjs && electron-builder --win nsis --publish never"
  },
  "license": "MIT",
  "dependencies": {
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "^1.69.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "esbuild@0.28.2": true
  },
  "productName": "Strongroom",
  "author": "Strongroom contributors",
  "build": {
    "appId": "app.strongroom.desktop",
    "productName": "Strongroom",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "!dist/iconBitmap.cjs",
      "dist-extension/**",
      "package.json",
      "!node_modules/**"
    ],
    "asarUnpack": [
      "dist/nmhost.js",
      "dist-extension/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Strongroom",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Strongroom-Setup-${version}.exe",
      "uninstallDisplayName": "Strongroom"
    }
  }
}
