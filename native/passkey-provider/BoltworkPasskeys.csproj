<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Boltwork's Windows passkey provider: a small packaged COM server that Windows' WebAuthn platform
    calls when you pick Boltwork in its passkey dialog. It relays each request to the Boltwork app.
    Build: dotnet publish -c Release (see scripts/build-passkey-provider.mjs).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BoltworkPasskeys</AssemblyName>
    <RootNamespace>Boltwork.Passkeys</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
